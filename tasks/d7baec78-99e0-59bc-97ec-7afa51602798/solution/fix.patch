+async def _digest_auth(request, qop, user, passwd, algorithm, stale_after):
+    ctx = await _ctx(request)
+    require_cookie_handling = ctx.args_dict.get("require-cookie", "").lower() in (
+        "1",
+        "t",
+        "true",
+    )
+    if algorithm not in ("MD5", "SHA-256", "SHA-512"):
+        algorithm = "MD5"
+    if qop not in ("auth", "auth-int"):
+        qop = None
+
+    authorization = ctx.headers.get("Authorization")
+    credentials = None
+    if authorization:
+        credentials = compat.parse_authorization_header(authorization)
+
+    if (
+        not authorization
+        or not credentials
+        or credentials.type.lower() != "digest"
+        or (require_cookie_handling and "Cookie" not in ctx.headers)
+    ):
+        result = helpers.digest_challenge_response(ctx, qop, algorithm)
+        result.headers.append("set-cookie", compat.dump_cookie("stale_after", stale_after))
+        result.headers.append("set-cookie", compat.dump_cookie("fake", "fake_value"))
+        return result
+
+    if require_cookie_handling and ctx.cookies.get("fake") != "fake_value":
+        result = compat.json_response({"errors": ["missing cookie set on challenge"]})
+        result.headers.append("set-cookie", compat.dump_cookie("fake", "fake_value"))
+        result.status_code = 403
+        return result
+
+    current_nonce = credentials.get("nonce")
+    stale_after_value = ctx.cookies.get("stale_after")
+
+    if (
+        "last_nonce" in ctx.cookies
+        and current_nonce == ctx.cookies.get("last_nonce")
+        or stale_after_value == "0"
+    ):
+        result = helpers.digest_challenge_response(ctx, qop, algorithm, True)
+        result.headers.append("set-cookie", compat.dump_cookie("stale_after", stale_after))
+        result.headers.append("set-cookie", compat.dump_cookie("last_nonce", current_nonce))
+        result.headers.append("set-cookie", compat.dump_cookie("fake", "fake_value"))
+        return result
+
+    if not helpers.check_digest_auth(ctx, user, passwd):
+        result = helpers.digest_challenge_response(ctx, qop, algorithm, False)
+        result.headers.append("set-cookie", compat.dump_cookie("stale_after", stale_after))
+        result.headers.append("set-cookie", compat.dump_cookie("last_nonce", current_nonce))
+        result.headers.append("set-cookie", compat.dump_cookie("fake", "fake_value"))
+        return result
+
+    result = compat.json_response({"authenticated": True, "user": user})
+    result.headers.append("set-cookie", compat.dump_cookie("fake", "fake_value"))
+    if stale_after_value:
+        result.headers.append(
+            "set-cookie",
+            compat.dump_cookie("stale_after", helpers.next_stale_after_value(stale_after_value)),
+        )
+    return result
