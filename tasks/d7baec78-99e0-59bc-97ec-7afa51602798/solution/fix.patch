+class CorsMiddleware:
+    """Appends the CORS headers every response carries."""
+
+    def __init__(self, asgi_app):
+        self.app = asgi_app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        headers = dict((key.decode("latin-1").lower(), value.decode("latin-1"))
+                       for key, value in scope.get("headers", []))
+        origin = headers.get("origin", "*")
+        is_options = scope.get("method") == "OPTIONS"
+
+        async def send_with_cors(message):
+            if message["type"] == "http.response.start":
+                mutable = MutableHeaders(scope=message)
+                mutable.append("access-control-allow-origin", origin)
+                mutable.append("access-control-allow-credentials", "true")
+                if is_options:
+                    mutable.append(
+                        "access-control-allow-methods", "GET, POST, PUT, DELETE, PATCH, OPTIONS"
+                    )
+                    mutable.append("access-control-max-age", "3600")
+                    requested = headers.get("access-control-request-headers")
+                    if requested is not None:
+                        mutable.append("access-control-allow-headers", requested)
+            await send(message)
+
+        await self.app(scope, receive, send_with_cors)
+
+
+for _route in app.router.routes:
+    _methods = getattr(_route, "methods", None)
+    if _methods and "GET" in _methods:
+        _methods.add("HEAD")
+
+_FASTAPI_APP = app
+app = CorsMiddleware(app)
+
+
+def create_app():
+    return app
+
