--- /dev/null
+++ b/httpbin/testing.py
@@ -0,0 +1,191 @@
+# -*- coding: utf-8 -*-
+
+"""
+httpbin.testing
+~~~~~~~~~~~~~~~
+
+A tiny in-process test client for the ASGI application.
+
+The upstream test-suite was written against a blocking in-process client, so
+this adapter exposes the same handful of response attributes the suite relies
+on (``data``, ``json``, ``get_data``, ``content_length`` and
+``headers.get_all``) on top of :mod:`httpx`.
+"""
+
+import asyncio
+import json as _json
+
+import httpx
+
+
+class Headers:
+    """Case-insensitive header view with a ``get_all`` helper."""
+
+    __test__ = False
+
+    def __init__(self, headers):
+        self._headers = headers
+
+    def get(self, key, default=None):
+        value = self._headers.get(key)
+        return default if value is None else value
+
+    def get_all(self, key):
+        values = self._headers.get_list(key)
+        return values or None
+
+    def __contains__(self, key):
+        return key in self._headers
+
+    def __getitem__(self, key):
+        return self._headers[key]
+
+    def items(self):
+        return self._headers.items()
+
+    def keys(self):
+        return self._headers.keys()
+
+    def __iter__(self):
+        return iter(self._headers)
+
+
+class TestResponse:
+    """Minimal blocking-client compatible response wrapper."""
+
+    __test__ = False
+
+    def __init__(self, response):
+        self._response = response
+        self.status_code = response.status_code
+        self.headers = Headers(response.headers)
+
+    @property
+    def data(self):
+        return self._response.content
+
+    def get_data(self, as_text=False):
+        if as_text:
+            return self._response.text
+        return self._response.content
+
+    @property
+    def json(self):
+        return _json.loads(self._response.content.decode("utf-8"))
+
+    @property
+    def content_length(self):
+        value = self._response.headers.get("content-length")
+        return None if value is None else int(value)
+
+
+class _SyncASGITransport(httpx.BaseTransport):
+    """Drive the async ASGI transport from httpx's synchronous client."""
+
+    def __init__(self, app):
+        self._inner = httpx.ASGITransport(app=app)
+
+    def handle_request(self, request):
+        async def run():
+            response = await self._inner.handle_async_request(request)
+            await response.aread()
+            return response
+
+        response = asyncio.run(run())
+        headers = [
+            (key, value)
+            for key, value in response.headers.multi_items()
+            if key.lower() not in ("content-encoding", "transfer-encoding")
+        ]
+        return httpx.Response(
+            response.status_code,
+            headers=headers,
+            content=response.content,
+            extensions=response.extensions,
+        )
+
+
+class TestClient:
+    """Call an ASGI application in-process, like the old test client."""
+
+    __test__ = False
+
+    def __init__(self, app, base_url="http://localhost"):
+        self.app = app
+        self.base_url = base_url
+        self._client = httpx.Client(
+            transport=_SyncASGITransport(app),
+            base_url=base_url,
+            follow_redirects=False,
+        )
+
+    def open(self, path, method="GET", **kwargs):
+        kwargs.pop("environ_base", None)
+        content_type = kwargs.pop("content_type", None)
+        headers = kwargs.pop("headers", None)
+        if content_type is not None:
+            if headers is None:
+                headers = {"Content-Type": content_type}
+            elif isinstance(headers, dict):
+                headers = dict(headers)
+                headers.setdefault("Content-Type", content_type)
+            else:
+                headers = list(headers) + [("Content-Type", content_type)]
+        response = self._client.request(method, path, headers=headers, **kwargs)
+        return TestResponse(response)
+
+    def get(self, path, **kwargs):
+        return self.open(path, "GET", **kwargs)
+
+    def head(self, path, **kwargs):
+        return self.open(path, "HEAD", **kwargs)
+
+    def post(self, path, **kwargs):
+        return self.open(path, "POST", **kwargs)
+
+    def put(self, path, **kwargs):
+        return self.open(path, "PUT", **kwargs)
+
+    def patch(self, path, **kwargs):
+        return self.open(path, "PATCH", **kwargs)
+
+    def delete(self, path, **kwargs):
+        return self.open(path, "DELETE", **kwargs)
+
+    def options(self, path, **kwargs):
+        return self.open(path, "OPTIONS", **kwargs)
+
+    def close(self):
+        self._client.close()
+
+
+def raw_body_chunks(app, path, method="GET", headers=None):
+    """Run one request through the ASGI interface and return body chunks."""
+
+    scope = {
+        "type": "http",
+        "asgi": {"version": "3.0"},
+        "http_version": "1.1",
+        "method": method,
+        "scheme": "http",
+        "path": path,
+        "raw_path": path.encode("latin-1"),
+        "query_string": b"",
+        "root_path": "",
+        "headers": [(b"host", b"localhost")] + list(headers or []),
+        "client": ("127.0.0.1", 12345),
+        "server": ("localhost", 80),
+    }
+
+    async def receive():
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    async def send(message):
+        messages.append(message)
+
+    messages = []
+    asyncio.run(app(scope, receive, send))
+    return [m.get("body", b"") for m in messages if m["type"] == "http.response.body"]
+
+
+__all__ = ["TestClient", "TestResponse", "raw_body_chunks"]
