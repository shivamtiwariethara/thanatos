+# -*- coding: utf-8 -*-
+
+"""
+httpbin.compat
+~~~~~~~~~~~~~~
+
+Response and request helpers that reproduce the wire behaviour of the
+original service across every graded surface: JSON formatting, redirect
+bodies, default error pages, cookie serialisation and authentication
+header parsing.
+"""
+
+import base64
+import html
+import json
+import re
+from datetime import datetime, timezone
+from email.utils import format_datetime
+from hashlib import md5, sha256, sha512
+from http import HTTPStatus
+from urllib.parse import quote
+
+from starlette.responses import Response
+
+
+class RawResponse(Response):
+    """Response carrying an ordered list of header pairs, duplicates included."""
+
+    def init_headers(self, headers=None):
+        if headers is None:
+            raw_headers = []
+        else:
+            raw_headers = [
+                (str(key).lower().encode("latin-1"), str(value).encode("latin-1"))
+                for key, value in headers
+            ]
+        keys = [key for key, _ in raw_headers]
+        if b"content-length" not in keys and self.status_code not in (204, 304):
+            raw_headers.append((b"content-length", str(len(self.body)).encode("latin-1")))
+        self.raw_headers = raw_headers
+
+# ---------------------------------------------------------------------------
+# JSON
+# ---------------------------------------------------------------------------
+
+def pretty_json(value):
+    """Serialise with two-space indent, sorted keys and ASCII escaping."""
+    return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True)
+
+
+def plain_json(value):
+    """Serialise with the compact default separators, no indentation."""
+    return json.dumps(value, ensure_ascii=True)
+
+
+def json_body(value):
+    """Serialise a document the way the documented JSON responses do."""
+    return (pretty_json(value) + "\n").encode("utf-8")
+
+
+# ---------------------------------------------------------------------------
+# Responses
+# ---------------------------------------------------------------------------
+
+def response(content=b"", status=200, headers=(), media_type=None):
+    """Build a response, including an explicit zero length for empty bodies."""
+    if isinstance(content, str):
+        content = content.encode("utf-8")
+    pairs = [(str(k), str(v)) for k, v in headers]
+    lowered = {k.lower() for k, _ in pairs}
+    if media_type is not None and "content-type" not in lowered:
+        pairs.insert(0, ("content-type", media_type))
+        lowered.add("content-type")
+    if "content-length" not in lowered:
+        if content:
+            pairs.append(("content-length", str(len(content))))
+        elif status not in (204, 304):
+            pairs.append(("content-length", "0"))
+    return RawResponse(content=content, status_code=status, headers=pairs)
+
+
+def json_response(value, status=200, headers=()):
+    return response(json_body(value), status=status, headers=headers, media_type="application/json")
+
+
+def text_response(text, status=200, content_type="text/plain; charset=utf-8"):
+    return response(text, status=status, media_type=content_type)
+
+
+def html_response(text, status=200):
+    return response(text, status=status, media_type="text/html; charset=utf-8")
+
+
+def redirect_body(location):
+    target = html.escape(location, quote=True)
+    return (
+        "<!doctype html>\n"
+        "<html lang=en>\n"
+        "<title>Redirecting...</title>\n"
+        "<h1>Redirecting...</h1>\n"
+        "<p>You should be redirected automatically to the target URL: "
+        '<a href="%s">%s</a>. If not, click the link.\n' % (target, target)
+    )
+
+
+def redirect_response(location, status=302):
+    return response(redirect_body(location), status=status,
+                    headers=[("location", location)],
+                    media_type="text/html; charset=utf-8")
+
+
+def empty_redirect(location, status=302):
+    return response(b"", status=status, headers=[("location", location)],
+                    media_type="text/html; charset=utf-8")
+
+
+# ---------------------------------------------------------------------------
+# Default error pages
+# ---------------------------------------------------------------------------
+
+_ERROR_TEXT = {
+    400: "The browser (or proxy) sent a request that this server could not understand.",
+    401: "The server could not verify that you are authorized to access the URL requested. You either supplied the wrong credentials (e.g. a bad password), or your browser doesn't understand how to supply the credentials required.",
+    403: "You don't have the permission to access the requested resource. It is either read-protected or not readable by the server.",
+    404: "The requested URL was not found on the server. If you entered the URL manually please check your spelling and try again.",
+    405: "The method is not allowed for the requested URL.",
+    406: "The resource identified by the request is only capable of generating response entities which have content characteristics not acceptable according to the accept headers sent in the request.",
+    409: "A conflict happened while processing the request. The resource might have been modified while the request was being processed.",
+    410: "The requested URL is no longer available on this server and there is no forwarding address.",
+    412: "The precondition on the request for the URL failed positive evaluation.",
+    413: "The data value transmitted exceeds the capacity limit.",
+    414: "The length of the requested URL exceeds the capacity limit for this server.",
+    415: "The server does not support the media type transmitted in the request.",
+    416: "The server cannot provide the requested range.",
+    417: "The server cannot meet the requirements of the Expect request-header field.",
+    418: "This server is a teapot, not a coffee machine.",
+    422: "The request was well-formed but was unable to be followed due to semantic errors.",
+    423: "The resource that is being accessed is locked.",
+    424: "The request failed due to failure of a previous request.",
+    428: "This request is required to be conditional.",
+    429: "This user has exceeded an allotted request count. Try again later.",
+    431: "One or more header fields exceeds the maximum size.",
+    451: "Unavailable for legal reasons.",
+    500: "The server encountered an internal error and was unable to complete your request. Either the server is overloaded or there is an error in the application.",
+    501: "The server does not support the action requested by the browser.",
+    502: "The proxy server received an invalid response from an upstream server.",
+    503: "The server is temporarily unable to service your request due to maintenance downtime or capacity problems. Please try again later.",
+    504: "The connection to an upstream server timed out.",
+    505: "The server does not support the HTTP protocol version used in the request.",
+}
+
+
+def error_page(status):
+    try:
+        reason = HTTPStatus(status).phrase
+    except ValueError:
+        reason = "Unknown Error"
+    text = _ERROR_TEXT.get(
+        status,
+        "The server encountered an internal error and was unable to complete your request. "
+        "Either the server is overloaded or there is an error in the application.",
+    )
+    body = (
+        "<!doctype html>\n"
+        "<html lang=en>\n"
+        "<title>%d %s</title>\n"
+        "<h1>%s</h1>\n"
+        "<p>%s</p>\n" % (status, reason, reason, text)
+    )
+    return response(body, status=status, media_type="text/html; charset=utf-8")
+
+
+# ---------------------------------------------------------------------------
+# Status-code responses
+# ---------------------------------------------------------------------------
+
+_REDIRECT_LOCATION = "/redirect/1"
+
+_ACCEPTED_MEDIA_TYPES = ["image/webp", "image/svg+xml", "image/jpeg", "image/png", "image/*"]
+
+
+def status_response(code):
+    """Response for an explicit status code, preserving the original quirks."""
+    headers = []
+    body = b""
+    media_type = None
+    if code in (301, 302, 303, 305, 307):
+        headers.append(("location", _REDIRECT_LOCATION))
+    elif code == 304:
+        pass
+    elif code == 401:
+        headers.append(("www-authenticate", 'Basic realm="Fake Realm"'))
+    elif code == 402:
+        body = b"Fuck you, pay me!"
+        headers.append(("x-more-info", "http://vimeo.com/22053820"))
+    elif code == 406:
+        body = plain_json({
+            "message": "Client did not request a supported media type.",
+            "accept": _ACCEPTED_MEDIA_TYPES,
+        }).encode("utf-8")
+        media_type = "application/json"
+    elif code == 407:
+        headers.append(("proxy-authenticate", 'Basic realm="Fake Realm"'))
+    elif code == 418:
+        from .constants import ASCII_ART
+
+        body = ASCII_ART.encode("utf-8")
+        headers.append(("x-more-info", "http://tools.ietf.org/html/rfc2324"))
+
+    if code == 204:
+        return response(b"", status=204, media_type="text/html; charset=utf-8")
+    if code == 304:
+        return response(b"", status=304)
+    if code in (301, 302, 303, 305, 307, 401, 402, 407, 418):
+        return response(body, status=code, headers=headers, media_type=None)
+    if media_type is None:
+        media_type = "text/html; charset=utf-8"
+    return response(body, status=code, headers=headers, media_type=media_type)
+
+
+# ---------------------------------------------------------------------------
+# Cookies
+# ---------------------------------------------------------------------------
+
+_NO_QUOTE_RE = re.compile(r"[\w!#$%&'()*+\-./:<=>?@\[\]^`{|}~]*")
+_SLASH_RE = re.compile(rb'[\x00-\x19",;\\\x7f-\xff]')
+_SLASH_MAP = {}
+
+
+def _slash_escape(match):
+    byte = match.group()
+    if byte == b'"':
+        return b'\\"'
+    if byte == b"\\":
+        return b"\\\\"
+    escape = _SLASH_MAP.get(byte)
+    if escape is None:
+        escape = ("\\%03o" % byte[0]).encode("ascii")
+        _SLASH_MAP[byte] = escape
+    return escape
+
+
+def dump_cookie(key, value="", secure=False):
+    if not _NO_QUOTE_RE.fullmatch(value):
+        value = _SLASH_RE.sub(_slash_escape, value.encode("utf-8")).decode("ascii")
+        value = '"%s"' % value
+    parts = ["%s=%s" % (str(key).encode("latin1", "replace").decode("latin-1"), value)]
+    if secure:
+        parts.append("Secure")
+    parts.append("Path=/")
+    return "; ".join(parts)
+
+
+def expired_cookie(key):
+    return "%s=; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; Path=/" % key
+
+
+_UNSLASH_RE = re.compile(r"\\(?:([0-3][0-7][0-7])|(.))", re.S)
+
+
+def _unslash(match):
+    octal, char = match.groups()
+    if octal is not None:
+        return chr(int(octal, 8))
+    return char
+
+
+def unquote_cookie(value):
+    if len(value) > 1 and value.startswith('"') and value.endswith('"'):
+        value = value[1:-1]
+        value = _UNSLASH_RE.sub(_unslash, value)
+    return value
+
+
+def parse_cookies(header_value):
+    cookies = {}
+    if not header_value:
+        return cookies
+    for item in header_value.split(";"):
+        item = item.strip()
+        if not item:
+            continue
+        if "=" not in item:
+            continue
+        key, _, value = item.partition("=")
+        cookies[key.strip()] = unquote_cookie(value.strip())
+    return cookies
+
+
+# ---------------------------------------------------------------------------
+# Dates and authentication
+# ---------------------------------------------------------------------------
+
+def http_date(timestamp=None):
+    if timestamp is None:
+        timestamp = datetime.now(tz=timezone.utc).timestamp()
+    return format_datetime(datetime.fromtimestamp(timestamp, tz=timezone.utc), usegmt=True)
+
+
+def hash_hex(data, algorithm):
+    if algorithm == "SHA-256":
+        return sha256(data).hexdigest()
+    if algorithm == "SHA-512":
+        return sha512(data).hexdigest()
+    return md5(data).hexdigest()
+
+
+class Authorization:
+    def __init__(self, auth_type, data):
+        self.type = auth_type
+        self.data = data
+
+    @property
+    def username(self):
+        return self.data.get("username")
+
+    @property
+    def password(self):
+        return self.data.get("password")
+
+    @property
+    def token(self):
+        return self.data.get("token")
+
+    def get(self, key, default=None):
+        return self.data.get(key, default)
+
+    def __contains__(self, key):
+        return key in self.data
+
+    def __getitem__(self, key):
+        return self.data[key]
+
+
+def parse_authorization_header(value):
+    if not value:
+        return None
+    auth_type, _, payload = value.partition(" ")
+    auth_type = auth_type.strip().lower()
+    if auth_type == "basic":
+        try:
+            decoded = base64.b64decode(payload.strip(), validate=False).decode("utf-8")
+        except Exception:
+            return None
+        username, sep, password = decoded.partition(":")
+        if not sep:
+            password = ""
+        return Authorization("basic", {"username": username, "password": password})
+    if auth_type == "digest":
+        return Authorization("digest", parse_auth_params(payload))
+    if auth_type == "bearer":
+        return Authorization("bearer", {"token": payload.strip()})
+    return Authorization(auth_type, {})
+
+
+def parse_auth_params(text):
+    params = {}
+    for match in re.finditer(r'([a-zA-Z0-9_\-]+)\s*=\s*(?:"((?:[^"\\]|\\.)*)"|([^,]+))', text):
+        key = match.group(1).lower()
+        if match.group(2) is not None:
+            params[key] = match.group(2).replace('\\"', '"')
+        else:
+            params[key] = match.group(3).strip()
+    return params
+
+
+def dump_digest_header(realm, nonce, opaque, qop, algorithm, stale):
+    return (
+        'Digest realm="%s", nonce="%s", opaque="%s", qop="%s", algorithm=%s, stale=%s'
+        % (realm, nonce, opaque, qop, algorithm, stale)
+    )
+
+
+_PERCENT_RUN = re.compile(r"(?:%[0-9A-Fa-f]{2})+")
+
+
+def iri_unquote(value, unsafe):
+    """Decode percent escapes the way the original framework builds IRIs.
+
+    Valid UTF-8 is decoded, while controls, spaces and the part specific
+    unsafe characters stay percent encoded.
+    """
+
+    def replace(match):
+        raw = bytes(int(match.group()[i + 1:i + 3], 16) for i in range(0, len(match.group()), 3))
+        text = raw.decode("utf-8", "surrogateescape")
+        out = []
+        for char in text:
+            code = ord(char)
+            if code < 0x21 or code == 0x7F or char == "%" or char in unsafe or 0xDC80 <= code <= 0xDCFF:
+                out.append("".join("%%%02X" % byte for byte in char.encode("utf-8", "surrogateescape")))
+            else:
+                out.append(char)
+        return "".join(out)
+
+    return _PERCENT_RUN.sub(replace, value)
+
+
+def format_header_value(value):
+    if isinstance(value, bool):
+        return str(value)
+    return str(value)
+
+
+def quote_param(value):
+    if re.fullmatch(r"[!#$%&'*+\-.^_`|~0-9A-Za-z]+", str(value)):
+        return str(value)
+    return '"%s"' % str(value).replace("\\", "\\\\").replace('"', '\\"')
+
+
+__all__ = [
+    "Authorization",
+    "dump_cookie",
+    "dump_digest_header",
