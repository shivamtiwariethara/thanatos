+@app.get("/range/{numbytes:int}")
+async def range_request(request: Request, numbytes: int):
+    ctx = await _ctx(request)
+    if numbytes <= 0 or numbytes > (100 * 1024):
+        return compat.response(
+            b"number of bytes must be in the range (0, 102400]",
+            status=404,
+            headers=[("etag", "range%d" % numbytes), ("accept-ranges", "bytes")],
+            media_type="text/plain; charset=utf-8",
+        )
+
+    params = CaseInsensitiveDict(ctx.args)
+    chunk_size = max(1, int(params["chunk_size"])) if "chunk_size" in params else 10 * 1024
+    duration = float(params.get("duration", 0))
+    pause_per_byte = duration / numbytes
+    request_headers = get_headers(ctx)
+    first_byte_pos, last_byte_pos = helpers.get_request_range(request_headers, numbytes)
+    range_length = (last_byte_pos + 1) - first_byte_pos
+
+    if (
+        first_byte_pos > last_byte_pos
+        or first_byte_pos not in range(0, numbytes)
+        or last_byte_pos not in range(0, numbytes)
+    ):
+        return compat.response(
+            b"",
+            status=416,
+            headers=[
+                ("etag", "range%d" % numbytes),
+                ("accept-ranges", "bytes"),
+                ("content-range", "bytes */%d" % numbytes),
+                ("content-length", "0"),
+            ],
+            media_type="text/plain; charset=utf-8",
+        )
+
+    async def generate_bytes():
+        chunks = bytearray()
+        for index in range(first_byte_pos, last_byte_pos + 1):
+            chunks.append(ord("a") + (index % 26))
+            if len(chunks) == chunk_size:
+                yield bytes(chunks)
+                if pause_per_byte:
+                    await asyncio.sleep(pause_per_byte * chunk_size)
+                chunks = bytearray()
+        if chunks:
+            if pause_per_byte:
+                await asyncio.sleep(pause_per_byte * len(chunks))
+            yield bytes(chunks)
+
+    content_range = "bytes %d-%d/%d" % (first_byte_pos, last_byte_pos, numbytes)
+    status = 200 if (first_byte_pos == 0 and last_byte_pos == (numbytes - 1)) else 206
+    return StreamingResponse(
+        generate_bytes(),
+        status_code=status,
+        headers={
+            "content-type": "application/octet-stream",
+            "etag": "range%d" % numbytes,
+            "accept-ranges": "bytes",
+            "content-length": str(range_length),
+            "content-range": content_range,
+        },
+    )
