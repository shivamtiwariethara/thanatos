+class RequestData:
+    """Parsed view of the incoming request used by the handlers."""
+
+    def __init__(self, request, raw, raw_headers, query_pairs, form_pairs, files):
+        self.request = request
+        self.raw = raw
+        self.raw_headers = raw_headers
+        self._query_pairs = query_pairs
+        self._form_pairs = form_pairs
+        self.files = files
+        self.method = request.method
+        self.path = request.url.path
+        self.query_string = compat.iri_unquote(
+            request.scope.get("query_string", b"").decode("latin-1"), "&=+#"
+        )
+
+    @classmethod
+    async def load(cls, request):
+        raw = await request.body()
+        header_items = []
+        for name, value in request.scope.get("headers", []):
+            header_items.append((name.decode("latin-1"), value.decode("latin-1")))
+        query_string = request.scope.get("query_string", b"").decode("latin-1")
+        query_pairs = parse_qsl(query_string, keep_blank_values=True, encoding="utf-8", errors="replace")
+
+        content_type = ""
+        for name, value in header_items:
+            if name.lower() == "content-type":
+                content_type = value.lower()
+                break
+
+        form_pairs = []
+        files = {}
+        parsed_form = False
+        if content_type.startswith("application/x-www-form-urlencoded"):
+            parsed_form = True
+            try:
+                form_pairs = parse_qsl(
+                    raw.decode("utf-8", "replace"),
+                    keep_blank_values=True,
+                    encoding="utf-8",
+                    errors="replace",
+                )
+            except Exception:
+                form_pairs = []
+        elif content_type.startswith("multipart/form-data"):
+            parsed_form = True
+            try:
+                form = await request.form()
+                for key, value in form.multi_items():
+                    if isinstance(value, UploadFile):
+                        payload = await value.read()
+                        files.setdefault(key, []).append(
+                            json_safe(payload, value.content_type or "application/octet-stream")
+                        )
+                    else:
+                        form_pairs.append((key, value))
+            except Exception:
+                form_pairs = []
+                files = {}
+
+        instance = cls(request, raw, header_items, query_pairs, form_pairs, files)
+        instance.parsed_form = parsed_form
+        return instance
