@@ -0,0 +1,1041 @@
+# -*- coding: utf-8 -*-
+
+"""
+httpbin.app
+~~~~~~~~~~~
+
+HTTP Request and Response Service implemented on an ASGI stack.
+
+The public surface mirrors the original service: the same routes, the same
+status codes, headers, bodies, error pages, redirect behaviour, cookie
+formatting and JSON layout.
+"""
+
+import asyncio
+import base64
+import json
+import os
+import random
+import re
+import time
+import uuid
+from pathlib import Path
+from urllib.parse import parse_qsl, quote, urlencode
+
+from fastapi import FastAPI, Request
+from starlette.datastructures import MutableHeaders
+from starlette.exceptions import HTTPException as StarletteHTTPException
+from starlette.responses import StreamingResponse
+from starlette.routing import Match
+
+from . import compat, filters, helpers
+from .constants import ACCEPTED_MEDIA_TYPES, ANGRY_ASCII, ROBOT_TXT
+from .helpers import RequestData, get_dict, get_headers, status_code
+from .structures import CaseInsensitiveDict
+from .utils import weighted_choice
+
+BASE_DIR = Path(__file__).resolve().parent
+TEMPLATE_DIR = BASE_DIR / "templates"
+
+try:
+    from importlib.metadata import version as _version
+
+    version = _version("httpbin")
+except Exception:  # pragma: no cover - editable installs without metadata
+    version = "0.10.4"
+
+ENV_COOKIES = (
+    "_gauges_unique",
+    "_gauges_unique_year",
+    "_gauges_unique_month",
+    "_gauges_unique_day",
+    "_gauges_unique_hour",
+    "__utmz",
+    "__utma",
+    "__utmb",
+)
+
+# ---------------------------------------------------------------------------
+# URL building used by templates and redirects
+# ---------------------------------------------------------------------------
+
+ENDPOINTS = {
+    "view_landing_page": "/",
+    "view_html_page": "/html",
+    "view_robots_page": "/robots.txt",
+    "view_deny_page": "/deny",
+    "view_origin": "/ip",
+    "view_uuid": "/uuid",
+    "view_headers": "/headers",
+    "view_user_agent": "/user-agent",
+    "view_get": "/get",
+    "view_anything": "/anything",
+    "view_post": "/post",
+    "view_put": "/put",
+    "view_patch": "/patch",
+    "view_delete": "/delete",
+    "view_gzip_encoded_content": "/gzip",
+    "view_deflate_encoded_content": "/deflate",
+    "view_brotli_encoded_content": "/brotli",
+    "redirect_n_times": "/redirect/<n>",
+    "relative_redirect_n_times": "/relative-redirect/<n>",
+    "absolute_redirect_n_times": "/absolute-redirect/<n>",
+    "redirect_to": "/redirect-to",
+    "stream_n_messages": "/stream/<n>",
+    "view_status_code": "/status/<codes>",
+    "response_headers": "/response-headers",
+    "view_cookies": "/cookies",
+    "set_cookies": "/cookies/set",
+    "set_cookie": "/cookies/set/<name>/<value>",
+    "delete_cookies": "/cookies/delete",
+    "view_forms_post": "/forms/post",
+    "basic_auth": "/basic-auth/<user>/<passwd>",
+    "hidden_basic_auth": "/hidden-basic-auth/<user>/<passwd>",
+    "bearer_auth": "/bearer",
+    "digest_auth_md5": "/digest-auth/<qop>/<user>/<passwd>",
+    "digest_auth_nostale": "/digest-auth/<qop>/<user>/<passwd>/<algorithm>",
+    "digest_auth": "/digest-auth/<qop>/<user>/<passwd>/<algorithm>/<stale_after>",
+    "delay_response": "/delay/<delay>",
+    "drip": "/drip",
+    "decode_base64": "/base64/<value>",
+    "cache": "/cache",
+    "etag": "/etag/<etag>",
+    "cache_control": "/cache/<value>",
+    "encoding": "/encoding/utf8",
+    "random_bytes": "/bytes/<n>",
+    "stream_random_bytes": "/stream-bytes/<n>",
+    "range_request": "/range/<numbytes>",
+    "link_page": "/links/<n>/<offset>",
+    "links": "/links/<n>",
+    "image": "/image",
+    "image_png": "/image/png",
+    "image_jpeg": "/image/jpeg",
+    "image_webp": "/image/webp",
+    "image_svg": "/image/svg",
+    "xml": "/xml",
+    "a_json_endpoint": "/json",
+}
+
+_PLACEHOLDER_RE = re.compile(r"<(?:(?P<converter>[a-z]+):)?(?P<name>[a-zA-Z_][a-zA-Z0-9_]*)>")
+_PATH_SAFE = "!$&'()*+,/:;=@"
+_QUERY_SAFE = "!$'()*,/:;?@"
+
+
+class BuildError(Exception):
+    pass
+
+
+def url_for(endpoint, request=None, external=False, **values):
+    try:
+        rule = ENDPOINTS[endpoint]
+    except KeyError:
+        raise BuildError(endpoint)
+    remaining = dict(values)
+    used = set()
+
+    def replace(match):
+        name = match.group("name")
+        if name not in remaining:
+            raise BuildError("missing value for %s" % name)
+        value = remaining.pop(name)
+        used.add(name)
+        return quote(str(value), safe=_PATH_SAFE)
+
+    path = _PLACEHOLDER_RE.sub(replace, rule)
+    query_items = [(k, v) for k, v in remaining.items() if v is not None]
+    if query_items:
+        path = path + "?" + urlencode(query_items, safe=_QUERY_SAFE)
+    if external:
+        if request is None:
+            raise BuildError("external URL requires a request")
+        host = request.headers.get("host", "")
+        scheme = request.url.scheme
+        return "%s://%s%s" % (scheme, host, path)
+    return path
+
+
+def _make_templates():
+    from jinja2 import Environment, FileSystemLoader, select_autoescape
+
+    env = Environment(
+        loader=FileSystemLoader(str(TEMPLATE_DIR)),
+        autoescape=select_autoescape(["html", "htm", "xml", "xhtml"]),
+    )
+    env.globals["tracking_enabled"] = "HTTPBIN_TRACKING" in os.environ
+
+    def template_url_for(endpoint, **values):
+        external = bool(values.pop("_external", False))
+        return url_for(endpoint, external=external, **values)
+
+    env.globals["url_for"] = template_url_for
+    return env
+
+
+TEMPLATES = _make_templates()
+
+
+def render_template(name):
+    return TEMPLATES.get_template(name).render()
+
+
+# ---------------------------------------------------------------------------
+# Application
+# ---------------------------------------------------------------------------
+
+app = FastAPI(docs_url=None, redoc_url=None, openapi_url=None, redirect_slashes=False)
+app.router.redirect_slashes = False
+
+
+def _load_route_regex(path):
+    pattern = re.escape(path)
+    pattern = pattern.replace(r"\{", "{")
+    pattern = pattern.replace(r"\}", "}")
+    pattern = re.sub(r"\{[a-zA-Z_][a-zA-Z0-9_]*:int\}", "[0-9]+", pattern)
+    pattern = re.sub(r"\{[a-zA-Z_][a-zA-Z0-9_]*:path\}", ".*", pattern)
+    pattern = re.sub(r"\{[a-zA-Z_][a-zA-Z0-9_]*\}", "[^/]+", pattern)
+    return re.compile("^" + pattern + "$")
+
+
+_ROUTE_CACHE = []
+
+
+def allowed_methods(path):
+    """Ordered set of methods the same path accepts on the original service."""
+    if not _ROUTE_CACHE:
+        for route in _FASTAPI_APP.router.routes:
+            route_path = getattr(route, "path", None)
+            methods = getattr(route, "methods", None)
+            if route_path == "/{full_path:path}":
+                continue
+            if route_path and methods:
+                _ROUTE_CACHE.append((_load_route_regex(route_path), set(methods)))
+    methods = set()
+    for regex, route_methods in _ROUTE_CACHE:
+        if regex.match(path):
+            methods |= route_methods
+    if methods:
+        methods.add("OPTIONS")
+    order = ["GET", "HEAD", "POST", "PUT", "DELETE", "PATCH", "TRACE", "OPTIONS"]
+    return [method for method in order if method in methods]
+
+
+def _compressed_json(ctx_or_dict):
+    body = compat.json_body(ctx_or_dict)
+    return body
+
+
+def _encoded_response(payload, encoder, method):
+    body = compat.json_body(payload)
+    encoded = encoder(body)
+    return compat.response(
+        encoded,
+        headers=[("content-encoding", {"gzip": "gzip", "deflate": "deflate", "brotli": "br"}[method])],
+        media_type="application/json",
+    )
+
+
+async def _ctx(request):
+    return await RequestData.load(request)
+
+
+# -- static and informational pages ----------------------------------------
+
+@app.get("/")
+async def view_landing_page():
+    return compat.html_response(render_template("index.html"))
+
+
+@app.get("/html")
+async def view_html_page():
+    return compat.html_response(render_template("moby.html"))
+
+
+@app.get("/robots.txt")
+async def view_robots_page():
+    return compat.response(ROBOT_TXT.encode("utf-8"), media_type="text/plain")
+
+
+@app.get("/deny")
+async def view_deny_page():
+    return compat.response(ANGRY_ASCII.encode("utf-8"), media_type="text/plain")
+
+
+@app.get("/ip")
+async def view_origin(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response({"origin": ctx.headers.get("X-Forwarded-For", ctx.remote_addr)})
+
+
+@app.get("/uuid")
+async def view_uuid():
+    return compat.json_response({"uuid": str(uuid.uuid4())})
+
+
+@app.get("/headers")
+async def view_headers(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response({"headers": get_headers(ctx)})
+
+
+@app.get("/user-agent")
+async def view_user_agent(request: Request):
+    ctx = await _ctx(request)
+    headers = get_headers(ctx)
+    return compat.json_response({"user-agent": headers["user-agent"]})
+
+
+# -- request echo ----------------------------------------------------------
+
+@app.get("/get")
+async def view_get(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response(get_dict(ctx, "url", "args", "headers", "origin"))
+
+
+_ECHO_METHODS = ["GET", "POST", "PUT", "DELETE", "PATCH", "TRACE"]
+
+
+@app.api_route("/anything", methods=_ECHO_METHODS)
+async def view_anything(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response(
+        get_dict(ctx, "url", "args", "headers", "origin", "method", "form", "data", "files", "json")
+    )
+
+
+@app.api_route("/anything/{anything:path}", methods=_ECHO_METHODS)
+async def view_anything_path(request: Request, anything: str):
+    ctx = await _ctx(request)
+    return compat.json_response(
+        get_dict(ctx, "url", "args", "headers", "origin", "method", "form", "data", "files", "json")
+    )
+
+
+@app.post("/post")
+async def view_post(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response(
+        get_dict(ctx, "url", "args", "form", "data", "origin", "headers", "files", "json")
+    )
+
+
+@app.put("/put")
+async def view_put(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response(
+        get_dict(ctx, "url", "args", "form", "data", "origin", "headers", "files", "json")
+    )
+
+
+@app.patch("/patch")
+async def view_patch(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response(
+        get_dict(ctx, "url", "args", "form", "data", "origin", "headers", "files", "json")
+    )
+
+
+@app.delete("/delete")
+async def view_delete(request: Request):
+    ctx = await _ctx(request)
+    return compat.json_response(
+        get_dict(ctx, "url", "args", "form", "data", "origin", "headers", "files", "json")
+    )
+
+
+# -- compressed responses --------------------------------------------------
+
+@app.get("/gzip")
+async def view_gzip_encoded_content(request: Request):
+    ctx = await _ctx(request)
+    payload = get_dict(ctx, "origin", "headers", method=ctx.method, gzipped=True)
+    return _encoded_response(payload, filters.gzip_bytes, "gzip")
+
+
+@app.get("/deflate")
+async def view_deflate_encoded_content(request: Request):
+    ctx = await _ctx(request)
+    payload = get_dict(ctx, "origin", "headers", method=ctx.method, deflated=True)
+    return _encoded_response(payload, filters.deflate_bytes, "deflate")
+
+
+@app.get("/brotli")
+async def view_brotli_encoded_content(request: Request):
+    ctx = await _ctx(request)
+    payload = get_dict(ctx, "origin", "headers", method=ctx.method, brotli=True)
+    return _encoded_response(payload, filters.brotli_bytes, "brotli")
+
+
+# -- redirects -------------------------------------------------------------
+
+@app.get("/redirect/{n:int}")
+async def redirect_n_times(request: Request, n: int):
+    assert n > 0
+    ctx = await _ctx(request)
+    absolute = dict(ctx.args).get("absolute", "false").lower() == "true"
+    if n == 1:
+        return compat.redirect_response(url_for("view_get", request=request, external=absolute))
+    if absolute:
+        return compat.redirect_response(
+            url_for("absolute_redirect_n_times", request=request, external=True, n=n - 1)
+        )
+    return compat.redirect_response(url_for("relative_redirect_n_times", n=n - 1))
+
+
+@app.get("/relative-redirect/{n:int}")
+async def relative_redirect_n_times(n: int):
+    assert n > 0
+    if n == 1:
+        return compat.empty_redirect(url_for("view_get"))
+    return compat.empty_redirect(url_for("relative_redirect_n_times", n=n - 1))
+
+
+@app.get("/absolute-redirect/{n:int}")
+async def absolute_redirect_n_times(request: Request, n: int):
+    assert n > 0
+    if n == 1:
+        return compat.redirect_response(url_for("view_get", request=request, external=True))
+    return compat.redirect_response(
+        url_for("absolute_redirect_n_times", request=request, external=True, n=n - 1)
+    )
+
+
+@app.api_route("/redirect-to", methods=_ECHO_METHODS)
+async def redirect_to(request: Request):
+    ctx = await _ctx(request)
+    args = CaseInsensitiveDict(ctx.args_dict)
+    status = 302
+    if "status_code" in args:
+        candidate = int(args["status_code"])
+        if 300 <= candidate < 400:
+            status = candidate
+    location = args["url"] if "url" in args else "None"
+    return compat.empty_redirect(location, status=status)
+
+
+@app.get("/stream/{n:int}")
+async def stream_n_messages(request: Request, n: int):
+    ctx = await _ctx(request)
+    payload = get_dict(ctx, "url", "args", "headers", "origin")
+    n = min(n, 100)
+
+    def generate_stream():
+        for index in range(n):
+            payload["id"] = index
+            yield json.dumps(payload) + "\n"
+
+    return StreamingResponse(generate_stream(), headers={"content-type": "application/json"})
+
+
+# -- status codes ----------------------------------------------------------
+
+@app.api_route("/status/{codes}", methods=_ECHO_METHODS)
+async def view_status_code(codes: str):
+    if "," not in codes:
+        try:
+            code = int(codes)
+        except ValueError:
+            return compat.response(b"Invalid status code", status=400,
+                                   media_type="text/plain; charset=utf-8")
+        return status_code(code)
+
+    choices = []
+    for choice in codes.split(","):
+        if ":" not in choice:
+            code = choice
+            weight = 1
+        else:
+            code, weight = choice.split(":")
+        try:
+            choices.append((int(code), float(weight)))
+        except ValueError:
+            return compat.response(b"Invalid status code", status=400,
+                                   media_type="text/plain; charset=utf-8")
+    return status_code(weighted_choice(choices))
+
+
+# -- response inspection ---------------------------------------------------
+
+@app.api_route("/response-headers", methods=["GET", "POST"])
+async def response_headers(request: Request):
+    ctx = await _ctx(request)
+    extra = list(ctx.args)
+    body = compat.json_body([list(item) for item in _group(extra)])
+
+    for _ in range(20):
+        original = body
+        collected = {"Content-Type": "application/json", "Content-Length": str(len(body))}
+        for key, value in extra:
+            if key in collected:
+                current = collected[key]
+                if not isinstance(current, list):
+                    current = [current]
+                current.append(value)
+                collected[key] = current
+            else:
+                collected[key] = value
+        body = compat.json_body(collected)
+        pairs = [("content-type", "application/json"), ("content-length", str(len(body)))]
+        pairs.extend(extra)
+        if len(body) == len(original) and body == original:
+            return compat.response(body, headers=pairs, media_type=None)
+    return compat.response(body, headers=pairs, media_type=None)
+
+
+def _group(pairs):
+    grouped = {}
+    for key, value in pairs:
+        grouped.setdefault(key, []).append(value)
+    return grouped.items()
+
