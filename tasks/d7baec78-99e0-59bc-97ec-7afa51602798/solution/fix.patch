+@app.get("/cache")
+async def cache(request: Request):
+    ctx = await _ctx(request)
+    conditional = ctx.headers.get("If-Modified-Since") or ctx.headers.get("If-None-Match")
+    if conditional is None:
+        result = compat.json_response(get_dict(ctx, "url", "args", "headers", "origin"))
+        result.headers.append("last-modified", compat.http_date())
+        result.headers.append("etag", uuid.uuid4().hex)
